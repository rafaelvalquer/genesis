{
  "name": "genesis-defense",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "assets:enemies": "node scripts/process-enemy-variants.mjs",
    "assets:enemy-anchors": "node scripts/generate-enemy-anchors.mjs --write",
    "assets:chapter2-cartoon-enemies": "node scripts/process-chapter2-cartoon-enemies.mjs",
    "assets:ram-beetle": "node scripts/process-ram-beetle-sheets.mjs",
    "assets:scarab-emperor": "node scripts/process-scarab-emperor-atlases.mjs",
    "assets:worker-queen": "node scripts/process-worker-queen-sheets.mjs",
    "assets:mago-abissal": "node scripts/process-mago-abissal-sheets.mjs",
    "assets:crisalio": "node scripts/process-crisalio-sheets.mjs",
    "assets:check-crisalio": "node scripts/check-crisalio-frames.mjs",
    "assets:artilheira-morteiro": "python scripts/process-artilheira-morteiro-sheets.py",
    "assets:colosso-impacto": "python scripts/process-colosso-impacto-sheets.py",
    "assets:executor-arco": "python scripts/process-executor-arco-sheets.py",
    "assets:pulso-desmaterializacao": "python scripts/process-dematerialization-pulse-sheets.py",
    "assets:interceptador-icaro": "node scripts/process-interceptador-icaro-sprites.mjs && node scripts/generate-icaro-sfx.mjs",
    "assets:wind-sfx": "node scripts/generate-wind-sfx.mjs",
    "assets:wind-effects": "node scripts/generate-wind-effects.mjs",
    "assets:drone-sentinela": "node scripts/process-drone-sentinela-sprites.mjs",
    "assets:cacador-leviatas": "node scripts/process-cacador-leviatas-sheet.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/game",
    "test:watch": "vitest",
    "sprites:audit": "node tools/auditSprites.mjs",
    "assets:leviathan:process": "node scripts/process-leviathan-nereida-sprites.mjs",
    "assets:leviathan:audit": "node scripts/audit-leviathan-sprite-components.mjs",
    "assets:leviathan:anchors": "node scripts/generate-enemy-anchors.mjs --enemy=leviathanNereida --write",
    "assets:leviathan": "npm run assets:leviathan:audit && npm run assets:leviathan:process && npm run assets:leviathan:anchors",
    "verify:encoding": "node scripts/check-encoding.mjs",
    "verify:assets": "node scripts/check-assets.js",
    "verify:crisalio": "node scripts/check-crisalio-frames.mjs",
    "audit:leviathan": "node scripts/audit-leviathan-sprite-components.mjs",
    "ci": "npm run verify:encoding && npm run verify:asset-boundaries && npm run verify:gamecanvas-render-dependencies && npm run verify:battle-loading && npm run test && npm run build",
    "release:check": "npm run ci && npm run verify:asset-manifest && npm run verify:assets && npm run verify:crisalio",
    "verify:asset-manifest": "node scripts/validate-asset-manifest.mjs --json=reports/asset-manifest.json",
    "verify:asset-boundaries": "node scripts/check-asset-module-boundaries.mjs",
    "verify:gamecanvas-render-dependencies": "node scripts/check-gamecanvas-render-dependencies.mjs",
    "verify:battle-loading": "node scripts/check-battle-loading-contract.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.3",
    "vitest": "^3.2.4",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.5.2"
  }
}
